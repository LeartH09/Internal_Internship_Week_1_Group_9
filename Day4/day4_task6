#include <stdio.h>
#include <string.h>

#define MAX_STUDENTS 5

enum Status {
    NEW = 1,
    ACTIVE,
    GRADUATED
};

// POINTER FUNCTION
void updateProgress(int *progress, enum Status *status) {

    printf("Vendos progresin e ri (0-100): ");
    scanf("%d", progress);

    if (*progress < 0) *progress = 0;
    if (*progress > 100) *progress = 100;

    if (*progress == 0)
        *status = NEW;
    else if (*progress < 100)
        *status = ACTIVE;
    else
        *status = GRADUATED;

    printf("Progresi u perditesua!\n");
}

int main() {

    int ids[MAX_STUDENTS];
    char emrat[MAX_STUDENTS][50];
    int progresat[MAX_STUDENTS];
    enum Status statuset[MAX_STUDENTS];

    int studentCount = 0;
    int zgjedhja;
    int running = 1;

    printf("=== STUDENT TRACKER FINAL v0.6===\n");

    while (running) {

        printf("\nMENU:\n");
        printf("1. Shto Student\n");
        printf("2. Shfaq Listen\n");
        printf("3. Raporti\n");
        printf("4. Perditeso Progres\n");
        printf("5. Kerko Student\n");
        printf("6. Ranking\n");
        printf("7. Dil\n");
        printf("Zgjedhja: ");

        if (scanf("%d", &zgjedhja) != 1) {
            printf("Gabim inputi!\n");
            while (getchar() != '\n');
            continue;
        }

        switch (zgjedhja) {

        // ADD
        case 1:
            if (studentCount < MAX_STUDENTS) {

                printf("Emri: ");
                scanf("%s", emrat[studentCount]);

                printf("ID: ");
                scanf("%d", &ids[studentCount]);

                printf("Progresi (0-100): ");
                scanf("%d", &progresat[studentCount]);

                if (progresat[studentCount] < 0) progresat[studentCount] = 0;
                if (progresat[studentCount] > 100) progresat[studentCount] = 100;

                int statusChoice, valid = 0;

                while (!valid) {
                    printf("Statusi (1-NEW, 2-ACTIVE, 3-GRADUATED): ");
                    scanf("%d", &statusChoice);

                    if (statusChoice >= 1 && statusChoice <= 3) {
                        statuset[studentCount] = (enum Status)statusChoice;
                        valid = 1;
                    } else {
                        printf("Status i pavlefshem!\n");
                    }
                }

                studentCount++;
                printf("Studenti u shtua!\n");

            } else {
                printf("Kapaciteti eshte plot!\n");
            }
            break;

        // DISPLAY
        case 2:
            if (studentCount == 0) {
                printf("Lista eshte bosh.\n");
                break;
            }

            printf("\n%-15s | %-5s | %-10s | %-12s\n",
                   "EMRI", "ID", "PROGRES", "STATUSI");

            for (int i = 0; i < studentCount; i++) {

                char *statusText;

                switch (statuset[i]) {
                    case NEW: statusText = "New"; break;
                    case ACTIVE: statusText = "Active"; break;
                    case GRADUATED: statusText = "Graduated"; break;
                    default: statusText = "Unknown";
                }

                printf("%-15s | %-5d | %-10d | %-12s\n",
                       emrat[i], ids[i], progresat[i], statusText);
            }
            break;

        // REPORT
        case 3: {
            if (studentCount == 0) {
                printf("Nuk ka te dhena.\n");
                break;
            }

            int sum = 0, graduated = 0;
            int max = progresat[0], min = progresat[0];

            for (int i = 0; i < studentCount; i++) {

                sum += progresat[i];

                if (statuset[i] == GRADUATED)
                    graduated++;

                if (progresat[i] > max) max = progresat[i];
                if (progresat[i] < min) min = progresat[i];
            }

            float avg = (float)sum / studentCount;

            printf("\n--- RAPORT ---\n");
            printf("Total: %d\n", studentCount);
            printf("Graduated: %d\n", graduated);
            printf("Mesatarja: %.2f\n", avg);

            if (avg >= 80) printf("Performance: Excellent\n");
            else if (avg >= 50) printf("Performance: Medium\n");
            else printf("Performance: Low\n");

            printf("Max: %d | Min: %d\n", max, min);
            break;
        }

        // POINTER UPDATE
        case 4: {
            int id, found = 0;

            printf("ID: ");
            scanf("%d", &id);

            for (int i = 0; i < studentCount; i++) {
                if (ids[i] == id) {
                    updateProgress(&progresat[i], &statuset[i]);
                    found = 1;
                    break;
                }
            }

            if (!found)
                printf("Studenti nuk u gjet!\n");

            break;
        }

        // SEARCH
        case 5: {
            int id, found = 0;

            printf("Kerko ID: ");
            scanf("%d", &id);

            for (int i = 0; i < studentCount; i++) {

                if (ids[i] == id) {
                    found = 1;

                    printf("Emri: %s | Progresi: %d\n",
                           emrat[i], progresat[i]);

                    if (progresat[i] < 50)
                        printf("⚠️ Progres i ulet!\n");
                    else if (progresat[i] >= 80)
                        printf("💡 Shume mire!\n");

                    break;
                }
            }

            if (!found)
                printf("Nuk u gjet!\n");

            break;
        }

        // SORT / RANKING
        case 6:
            for (int i = 0; i < studentCount - 1; i++) {
                for (int j = i + 1; j < studentCount; j++) {

                    if (progresat[i] < progresat[j]) {

                        int tp = progresat[i];
                        progresat[i] = progresat[j];
                        progresat[j] = tp;

                        int ti = ids[i];
                        ids[i] = ids[j];
                        ids[j] = ti;

                        char tn[50];
                        strcpy(tn, emrat[i]);
                        strcpy(emrat[i], emrat[j]);
                        strcpy(emrat[j], tn);

                        enum Status ts = statuset[i];
                        statuset[i] = statuset[j];
                        statuset[j] = ts;
                    }
                }
            }

            printf("Ranking:\n");
            for (int i = 0; i < studentCount; i++) {
                printf("%d. %s (%d)\n", i + 1, emrat[i], progresat[i]);
            }
            break;

        case 7:
            running = 0;
            break;

        default:
            printf("Opsion i pavlefshem!\n");
        }
    }

    return 0;
}
